# Production build calls the API on Render directly (CORS: WEB_ORIGINS on the API lists
# https://bagicha-web.vercel.app). Not through a Vercel rewrite: Vercel's proxy gives up
# (502) while the free Render plan wakes up (~30-45 s); a direct call waits it out.
VITE_API_URL=https://bagicha-api.onrender.com/api/v1
